<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>kz.iitu</groupId>
	<artifactId>spring-lab-01</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>spring-lab-01</name>
	<description>Spring labs</description>

	<properties>
		<java.version>25</java.version>
		<embedded-postgres.version>2.2.2</embedded-postgres.version>
		<embedded-postgres-binaries.version>17.11.0</embedded-postgres-binaries.version>
		<!-- Lab 12: OneDrive marks the folders it syncs read-only, and "mvnw clean" then fails with an
		     AccessDeniedException on target\classes\...; force lets the clean plugin delete them anyway -->
		<maven.clean.force>true</maven.clean.force>
		<!-- options for the test JVM that only one operating system needs; filled in by the "windows" profile -->
		<test.jvm.os-options></test.jvm.os-options>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- PostgreSQL 17 binaries for the embedded database used by the tests and LocalDevApplication -->
			<dependency>
				<groupId>io.zonky.test.postgres</groupId>
				<artifactId>embedded-postgres-binaries-bom</artifactId>
				<version>${embedded-postgres-binaries.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Lab 10: the security subsystem -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>   <!-- for sec:authorize in Thymeleaf templates -->
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!-- Persistence: JPA, Flyway owns the schema, PostgreSQL -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Lab 12. Versions come from the Spring Boot BOM. Boot 4.1 ships Testcontainers 2.x, whose modules are
		     called testcontainers-postgresql and testcontainers-junit-jupiter (the 1.x names are gone). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>   <!-- @DataJpaTest, TestEntityManager -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>   <!-- RestTestClient, @AutoConfigureRestTestClient -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-resttestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>   <!-- a real PostgreSQL started from the tests, no Docker needed -->
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<version>${embedded-postgres.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Lab 12: JaCoCo. prepare-agent gives the test JVM the coverage agent; report writes
			     target/site/jacoco in the verify phase. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<executions>
					<execution>
						<goals><goal>prepare-agent</goal></goals>
						<configuration>
							<propertyName>jacocoArgLine</propertyName>   <!-- assembled into argLine below -->
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals><goal>report</goal></goals>
					</execution>
				</executions>
			</plugin>
			<!-- Lab 12: defines ${org.mockito:mockito-core:jar} = the jar's path, for the -javaagent below -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>dependency-paths</id>
						<goals><goal>properties</goal></goals>
					</execution>
				</executions>
			</plugin>
			<!-- Lab 12: argLine of the test JVM = two agents.
			     1. Mockito. Its inline mock maker needs an agent; attaching one to a running JVM is deprecated since
			        JDK 21 and fails on this computer ("Could not self-attach to current VM"), so Mockito is a
			        -javaagent, as its documentation recommends.
			     2. JaCoCo. This project lives in "C:\Users\Айнур\OneDrive\Рабочий стол\...": the JVM reads the options
			        of a -javaagent in the wrong charset, the destfile turned into "C:\Users\?????\..." and the test JVM
			        died ("processing of -javaagent failed"). The destfile is rewritten to target/jacoco.exec relative
			        to the test JVM's working directory (the project) - the same file the report goal reads.
			     With -Djacoco.skip=true jacocoArgLine is empty and only Mockito is left. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>test-jvm-agents</id>
						<phase>initialize</phase>   <!-- after prepare-agent and dependency:properties (declared before it) -->
						<goals><goal>regex-property</goal></goals>
						<configuration>
							<name>argLine</name>
							<value>-javaagent:${org.mockito:mockito-core:jar} ${jacocoArgLine}</value>
							<regex>destfile=[^,"]+</regex>
							<replacement>destfile=target/jacoco.exec</replacement>
							<failIfNoMatch>false</failIfNoMatch>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} ${test.jvm.os-options}</argLine>   <!-- @{}: set at run time -->
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Lab 12: on Windows every NIO selector (Tomcat, the HTTP client behind RestTestClient) gets its internal pipe
		     from a Unix domain socket created in %TEMP%. With a non-ASCII %TEMP% (C:\Users\Айнур\AppData\Local\Temp)
		     the connect fails: "Unable to establish loopback connection". The sockets go to %PUBLIC% instead
		     (C:\Users\Public, present on every Windows). -->
		<profile>
			<id>windows</id>
			<activation>
				<os><family>windows</family></os>
			</activation>
			<properties>
				<test.jvm.os-options>-Djdk.net.unixdomain.tmpdir=${env.PUBLIC}</test.jvm.os-options>
			</properties>
		</profile>
	</profiles>
</project>